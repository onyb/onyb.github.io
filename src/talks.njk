---
layout: base.njk
pageTitle: talks
pageDescription: "Conference talks and meetup presentations by Anirudha Bose."
permalink: /talks/index.html
wide: true
---
<h1>talks</h1>
<p class="lede">
  Things I've said out loud at conferences and meetups. Reverse chronological — newest mistakes first.
</p>

{% for group in talks.list | byYearDesc %}
  <h2 class="year">{{ group.year }}</h2>
  <ul class="entries">
    {% for t in group.list %}
      {%- set primary = t.links[0] -%}
      <li>
        {% if primary %}<a class="title" href="{{ primary.url }}">{{ t.title }}</a>{% else %}<span class="title">{{ t.title }}</span>{% endif %}
        <span class="meta">
          {% if t.venue or t.country or t.online %}<span class="venue">{% if t.country %}<span class="flag" role="img" aria-label="{{ t.country | countryName }}" title="{{ t.country | countryName }}">{{ t.country | countryFlag }}</span>{% elif t.online %}<span class="flag" role="img" aria-label="Online" title="Online">🌐</span>{% endif %}{% if t.venue %}{{ t.venue }}{% endif %}</span>{% endif %}
          {% if t.links and t.links.length %}<span class="links">{% for l in t.links %}<a href="{{ l.url }}">{{ l.label }}</a>{% endfor %}</span>{% endif %}
        </span>
      </li>
    {% endfor %}
  </ul>
{% endfor %}
