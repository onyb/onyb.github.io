---
layout: base.njk
pageTitle: writing
permalink: /writing/index.html
wide: true
---
<h1>writing</h1>
<p class="lede">
  Old notes, long-form takes, and whatever I'm chewing on next.
</p>

{% for group in writings.list | byYearDesc %}
  <h2 class="year">{{ group.year }}</h2>
  <ul class="entries">
    {% for w in group.list %}
      <li>
        {% if w.external %}
          <a class="title" href="{{ w.external }}">{{ w.title }}</a>
          <span class="meta"><span class="host">{{ w.external | host }}</span></span>
        {% else %}
          <a class="title" href="/writing/{{ w.slug }}/">{{ w.title }}</a>
          <span class="meta">{% if w.kind %}<span class="kind">{{ w.kind }}</span>{% endif %}</span>
        {% endif %}
      </li>
    {% endfor %}
  </ul>
{% endfor %}
